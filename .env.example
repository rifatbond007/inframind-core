# InfraMind — local environment template.
# Copy to `.env` (gitignored) and fill in real values. Never commit `.env`.

# --- Event bus ---
REDIS_URL=redis://localhost:6379/0

# --- Storage ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=inframind
POSTGRES_USER=inframind
POSTGRES_PASSWORD=inframind
POSTGRES_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- LLM provider ---
# `openai` uses OPENAI_API_KEY. `ollama` runs locally, no key needed.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_S=20

# --- Observability backends (Step 1 will read these from the testbed) ---
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
JAEGER_URL=http://localhost:16686
ALERTMANAGER_WEBHOOK_URL=http://localhost:9093

# --- App ---
INFRAMIND_LOG_LEVEL=INFO
INFRAMIND_ENV=dev
