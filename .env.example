# InfraMind — local environment template.
# Copy to `.env` (gitignored) and fill in real values. Never commit `.env`.

# --- Event bus ---
REDIS_URL=redis://localhost:6379/0

# --- Storage ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=inframind
POSTGRES_USER=inframind
POSTGRES_PASSWORD=inframind
POSTGRES_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Storage tunables (INFRAMIND_STORAGE_*). Defaults live in src/inframind/storage/config.py.
INFRAMIND_STORAGE_POOL_MIN_SIZE=2
INFRAMIND_STORAGE_POOL_MAX_SIZE=10
INFRAMIND_STORAGE_COMMAND_TIMEOUT_S=10.0
INFRAMIND_STORAGE_MAX_PAGE_SIZE=100
INFRAMIND_STORAGE_DEFAULT_PAGE_SIZE=50

# P7 evaluation: unset in normal operation; the evaluation runner sets it per scenario so
# incidents can be correlated back to the scenario that produced them.
INFRAMIND_EVAL_SCENARIO_ID=

# Alerting tunables (INFRAMIND_ALERTING_*). Defaults live in src/inframind/alerting/config.py.
INFRAMIND_ALERTING_DEDUP_WINDOW_S=300.0
INFRAMIND_ALERTING_CONSOLE_ENABLED=true
INFRAMIND_ALERTING_WEBHOOK_URL=
INFRAMIND_ALERTING_WEBHOOK_TIMEOUT_S=5.0

# --- LLM provider ---
# `openai` uses OPENAI_API_KEY. `ollama` runs locally, no key needed.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_S=20

# --- Observability backends (Step 1 will read these from the testbed) ---
PROMETHEUS_URL=http://localhost:30090
LOKI_URL=http://localhost:30100
JAEGER_URL=http://localhost:30686
ALERTMANAGER_URL=http://localhost:30093

# --- Collectors (python -m inframind.ingestion.{prometheus,loki,jaeger}) ---
PROM_INTERVAL_S=30
LOKI_INTERVAL_S=30
JAEGER_INTERVAL_S=30

# --- API (python -m inframind.api.app) ---
# Bearer token Alertmanager must present on POST /webhooks/alertmanager.
# Empty on purpose: the API refuses to start without one. The testbed's dev value lives in
# testbed/helm-values/kube-prometheus-stack.yaml.
INFRAMIND_ALERT_WEBHOOK_SECRET=
INFRAMIND_API_HOST=0.0.0.0
INFRAMIND_API_PORT=8080

# --- App ---
INFRAMIND_LOG_LEVEL=INFO
INFRAMIND_ENV=dev
