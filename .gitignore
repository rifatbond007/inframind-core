# --- K8s / testbed (Step 1 will add real paths; block common ones up front) ---
kubeconfig
kubeconfig.*
*.kubeconfig
kind-*.log
kind-*.kubeconfig
.kube/
# Testbed-specific (Slice 2 writes a kubeconfig under testbed/.kube/; never commit)
testbed/.kube/
# observe-fault run output (signals, timelines); regenerate, never commit
testbed/.observe/
testbed/.kind/
testbed/.kind-bootstrap.log
testbed/**/kubeconfig
testbed/**/kubeconfig.*
testbed/**/*.kubeconfig
# Rendered chart outputs (slice 3+ — for `make obs` debug, not for commit)
testbed/helm-values/rendered/
testbed/helm-values/*.rendered.yaml
# Helm/cluster temporary artifacts
.helm/
charts/*.tgz

# --- editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- evaluation results (large / generated) ---
evaluation/results/*
!evaluation/results/.gitkeep

