      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "inframind-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT i.opened_at AS \"Opened\", i.state AS \"State\", i.severity AS \"Severity\",\n       c.service AS \"Root cause (top-1)\", c.score AS \"Score\",\n       c.change_correlation AS \"Change corr.\", i.title AS \"Title\",\n       extract(epoch FROM coalesce(i.closed_at, now()) - i.opened_at) AS \"Duration\",\n       jsonb_array_length(i.alerts) AS \"Alerts\", i.revision AS \"Rev\",\n       i.id AS \"Incident\",\n       (extract(epoch FROM i.opened_at) * 1000)::bigint - 300000 AS from_ms,\n       (extract(epoch FROM coalesce(i.closed_at, now())) * 1000)::bigint + 300000 AS to_ms\nFROM incidents i\nLEFT JOIN candidates c ON c.incident_id = i.id AND c.rank = 1\nWHERE $__timeFilter(i.opened_at)\nORDER BY i.opened_at DESC"
        }
      ]
    },
    {
      "type": "row",
      "id": 9,
      "title": "Service graph · $incident",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "nodegraph",
      "id": 10,
      "title": "Service graph (caller → callee, D2)",
      "description": "InfraMind's own call graph: edges are the calls the RCA worker folded into its graph and the failing calls call_error attributed (red, D30), over the dashboard time range. Ring colour: red = top-1 root cause, orange = other candidate, green = no candidate, grey = emits no traces.",
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 15,
        "h": 13
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "arc__root_cause"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "arc__candidate"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "arc__healthy"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "arc__no_traces"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8e8e8e"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "nodes": {
          "mainStatUnit": "none"
        },
        "edges": {
          "mainStatUnit": "cps"
        }
      },
      "targets": [
        {
          "refId": "nodes",
          "datasource": {
            "type": "postgres",
            "uid": "inframind-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "WITH svc(id, traced) AS (VALUES\n    ('frontend', true),\n    ('checkoutservice', true),\n    ('currencyservice', true),\n    ('paymentservice', true),\n    ('productcatalogservice', true),\n    ('recommendationservice', true),\n    ('adservice', false),\n    ('cartservice', false),\n    ('shippingservice', false),\n    ('emailservice', false),\n    ('redis-cart', false)),\ncand AS (SELECT service, rank, score FROM candidates WHERE incident_id = '$incident')\nSELECT s.id, s.id AS title,\n       concat_ws(' · ', CASE WHEN c.rank IS NOT NULL THEN 'rank ' || c.rank END,\n                 CASE WHEN NOT s.traced THEN 'no traces' END) AS subtitle,\n       round(c.score::numeric, 3) AS mainstat,\n       CASE WHEN c.rank = 1 THEN 1 ELSE 0 END AS arc__root_cause,\n       CASE WHEN c.rank > 1 THEN 1 ELSE 0 END AS arc__candidate,\n       CASE WHEN c.rank IS NULL AND s.traced THEN 1 ELSE 0 END AS arc__healthy,\n       CASE WHEN c.rank IS NULL AND NOT s.traced THEN 1 ELSE 0 END AS arc__no_traces\nFROM svc s LEFT JOIN cand c ON c.service = s.id\nORDER BY s.id"
        },
        {
          "refId": "edges",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "label_join(label_replace(label_replace(\n  label_replace(label_replace(sum by (caller, callee) (rate(inframind_call_errors_total[$__range])) > 0, \"color\", \"red\", \"\", \"\"), \"secondarystat\", \"failing calls/s\", \"\", \"\")\n  or on (caller, callee)\n  label_replace(label_replace(sum by (caller, callee) (rate(inframind_graph_call_latency_seconds_count[$__range])), \"color\", \"gray\", \"\", \"\"), \"secondarystat\", \"calls/s\", \"\", \"\"),\n  \"source\", \"$1\", \"caller\", \"(.*)\"), \"target\", \"$1\", \"callee\", \"(.*)\"),\n  \"id\", \" -> \", \"caller\", \"callee\")",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "caller": true,
              "callee": true
            },
            "renameByName": {
              "Value": "mainstat",
              "Value #edges": "mainstat"
            }
          }
        }
      ]
    },
    {
      "type": "table",
      "id": 11,
      "title": "Edges",
      "description": "Per edge over the dashboard time range: call rate and p95 latency from the RCA graph, failing calls from call_error (callees without traces appear only here and in red on the graph).",
