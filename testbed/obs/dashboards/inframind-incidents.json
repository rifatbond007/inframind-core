        "label": "Incident",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "inframind-postgres"
        },
        "query": "SELECT id AS __value,\n       to_char(opened_at AT TIME ZONE 'UTC', 'MM-DD HH24:MI') || ' UTC · ' || title || ' (' || state || ')' AS __text\nFROM incidents WHERE $__timeFilter(opened_at) ORDER BY opened_at DESC",
