          "expr": "sum by (service) (label_replace(rate(container_cpu_usage_seconds_total{namespace=\"default\", container!=\"\", container!=\"POD\", pod=~\"$service-.+\"}[1m]), \"service\", \"$1\", \"pod\", \"(.+)-[a-z0-9]{6,10}-[a-z0-9]{5}\"))",
          "legendFormat": "{{service}}"
        }
