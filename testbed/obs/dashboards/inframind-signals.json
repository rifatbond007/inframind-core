    {
      "type": "row",
      "title": "Alerts signal (what Alertmanager sends to the InfraMind webhook)",
      "id": 19,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 42
      },
      "panels": []
