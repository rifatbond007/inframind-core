          },
          "expr": "sum by (source) (rate(inframind_signals_received_total[2m]))",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 14,
      "title": "Anomalies by detector",
      "description": "Anomalies emitted per 2-minute window.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "gridPos": {
        "x": 6,
        "y": 22,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "smooth",
            "axisSoftMin": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
