      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "description": "Traces with an error span; the Jaeger collector turns these into error signals.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "jaeger",
            "uid": "${ds_jaeger}"
          },
          "queryType": "search",
          "service": "$trace_service",
          "tags": "error=true",
          "limit": 20
        }
      ]
    },
    {
      "type": "table",
      "title": "Recent traces: $trace_service",
      "id": 18,
      "datasource": {
