      },
      "targets": [
        {
          "expr": "sum by (app) (count_over_time({namespace=\"default\", app!=\"\"} |~ \"(?i)(error|warn|fatal|panic|exception|critical|severe|traceback)\" [1m]))",
          "legendFormat": "{{app}}",
