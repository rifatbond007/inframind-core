    {
      "type": "logs",
      "title": "Error/warn log lines",
      "id": 15,
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "{namespace=\"default\", app!=\"\"} |~ \"(?i)(error|warn|fatal|panic|exception|critical|severe|traceback)\"",
          "queryType": "range"
        }
      ]
    },
    {
      "type": "row",
