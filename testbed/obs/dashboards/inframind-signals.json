      "title": "InfraMind pipeline",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 13,
      "title": "Signals ingested",
      "description": "Signals published to stream:signals, by source.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "gridPos": {
        "x": 0,
