          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (service) (label_replace(container_memory_working_set_bytes{namespace=\"default\", container!=\"\", container!=\"POD\"}, \"service\", \"$1\", \"pod\", \"(.+)-[a-z0-9]{6,10}-[a-z0-9]{5}\"))",
          "legendFormat": "{{service}}",
          "refId": "A",
          "datasource": {
