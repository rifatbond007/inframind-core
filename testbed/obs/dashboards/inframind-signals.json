          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (service) (label_replace(rate(container_network_receive_bytes_total{namespace=\"default\"}[1m]), \"service\", \"$1\", \"pod\", \"(.+)-[a-z0-9]{6,10}-[a-z0-9]{5}\"))",
          "legendFormat": "{{service}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "Logs signal (what the Loki collector ingests)",
