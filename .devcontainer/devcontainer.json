{
  // D31 (proposed): the testbed may run in a GitHub Codespace instead of the dev laptop.
  // kind, InfraMind and the scenarios are unchanged; only the host machine differs.
  // Drive it from the laptop with `make remote-on` (see scripts/remote.mk).
  "name": "InfraMind testbed",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    // kind needs a Docker daemon inside the codespace.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    // `gh codespace ssh` (the laptop's remote mode) needs sshd.
    "ghcr.io/devcontainers/features/sshd:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  // The full testbed (2 kind nodes, ~40 pods, 8 compose containers) needs about 6 GiB;
  // 4 cores / 16 GB leaves headroom. Image layers for the charts and Boutique are ~10 GB.
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  // The testbed NodePorts and the InfraMind API. From the laptop, `make codespace-ports`
  // forwards the same ports to localhost, so the usual URLs keep working.
  "forwardPorts": [30300, 30090, 30093, 30686, 30100, 8080],
  "portsAttributes": {
    "30300": { "label": "Grafana" },
    "30090": { "label": "Prometheus" },
    "30093": { "label": "Alertmanager" },
    "30686": { "label": "Jaeger" },
    "30100": { "label": "Loki" },
    "8080": { "label": "InfraMind API" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    }
  }
}
